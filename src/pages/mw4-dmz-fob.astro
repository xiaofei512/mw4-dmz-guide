---
import GuideLayout from '../layouts/GuideLayout.astro';
import FilterableTable from '../components/FilterableTable.astro';

const rows = [
  [
    "Operators (Active Duty)",
    "Available Immediately / Accessed within the FOB (or left-blade menu)",
    "Manage available Operators, check status, upgrade Traits, and select one ready for deployment.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "DMZ Orders",
    "Available Immediately / Accessed within the FOB",
    "Guiding Mission Directives: onboard, tell DMZ’s story, and challenge mastery of the exclusion zone; view current objectives (Pages) and rewards.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Stash / Loadout",
    "Available Immediately / Accessed within the FOB (or left-blade menu)",
    "Stash stores loot types (Weapons, Gear, 3D Printer Ingredients, Keys, valuables, etc.) shared across Active Duty Operators; Loadout equips weapons and gear for the next infil.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Firing Range",
    "Available Immediately / Accessed within the FOB",
    "Test weapons (especially optics) and sharpen aim; targets from close range to more than 100 meters.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Survival Kits",
    "Available Immediately / Accessed within the FOB",
    "Themed packs of loot that can be opened to gear up or craft; unopened kits stack in the station menu.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Bounty Leaderboard",
    "Available Immediately / Accessed at a physical Station within the FOB",
    "Track the most successful PvP bounty hunters and killers; Top 50 Most Wanted and Top 50 Bounty Hunters (Global / Friends).",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "DMZ Progression",
    "Available Immediately / FOB Station, left-blade, or Career > Progression",
    "Dedicated DMZ Progression Track: awards Printer Recipes, unlocks FOB stations, and other content up to level 70.",
    "confirmed",
    "2026-10-24",
    "[1][2]"
  ],
  [
    "Deploy",
    "Available Immediately / Deploy menu or Deploy area",
    "Threshold to heavy-lift transport; begin each DMZ deployment (Story Missions / Dynamic Operations / Free Roam).",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Events",
    "Available Immediately / Accessed within the FOB (or left-blade menu)",
    "When an Event is active: challenges or other unlocks, many time-limited.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "3D Printer",
    "Unlocks at DMZ Player Level 2",
    "Craft gear using Printer Resources and 3D Printer Ingredients; also upgrade various FOB stations when required loot items are available.",
    "confirmed",
    "2026-10-24",
    "[1][2]"
  ],
  [
    "Boss Board",
    "Unlocks after completing your second DMZ Order",
    "Purchase intel on Lieutenants; locate and hunt powerful adversaries; additional free info for Commanders.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Vendor",
    "Unlocks at DMZ Player Level 5",
    "Buy weapons and other items with DMZ Cash; wares rotate day to day.",
    "confirmed",
    "2026-10-24",
    "[1]"
  ],
  [
    "Gunsmith",
    "Unlocks at DMZ Player Level 10",
    "Purchase attachments for looted weapons and build new weapons from scratch with DMZ Cash; attachments relate to weapon level / shared unlocks; extract Weapon Manuals to expand purchasable weapons.",
    "confirmed",
    "2026-10-24",
    "[1][2]"
  ],
  [
    "Dog Tag Case",
    "Unlocks at DMZ Player Level 20",
    "Display Dog Tags collected from defeated Operators; favorite ones you don’t want to lose.",
    "confirmed",
    "2026-10-24",
    "[1][2]"
  ]
];
---
<GuideLayout title="MW4 DMZ FOB Unlocks" lang="zh-CN">
  <div slot="definition">
    <p>本表说明 MW4 DMZ <strong>FOB（Forward Operating Base）</strong> 相关解锁：站点/项目、需求、解锁后用途摘要。</p>
    <p>FOB 是部署之间的指挥中心：卸货、整备、接取 Orders，并承载 DMZ 永久进度（含 Active Duty Operators）。</p>
    <p>官方 DMZ Deep Dive Part 2（FOB Full Intel Guide，October 09, 2026）逐站描述了立即可用与按等级/条件解锁的站点。</p>
    <p><strong>不</strong>编造博客未给出的升级花费、配方全表、Vendor 轮换库存或折扣数值。</p>
  </div>
  <div slot="how-to">
    <ol>
      <li>读 <code>Level or requirement</code> 与 <code>What it enables</code> 时先看 <code>Status</code>；<code>confirmed</code> 行均可回溯到 Sources <a href="#source-1">[1]</a>。</li>
      <li><strong>筛选项：</strong> Site / unlock · Status。</li>
      <li>升级/配方/Bank 扩容等未在官方站点清单钉死的项：留空或另开 <code>reported</code>，本批不填。</li>
      <li>回 <a href="/dmz-mw4/">/dmz-mw4</a>；官方全文见 Sources <a href="#source-1">[1]</a>。</li>
    </ol>
  </div>
  <div slot="body">
    <p><strong>筛选项：</strong> Site / unlock · Level or requirement · Status</p>
    <FilterableTable
      columns={["Site / unlock", "Level or requirement", "What it enables", "Status", "Last verified", "Sources"]}
      caption="MW4 DMZ FOB Unlocks — 14 行 confirmed 站点/解锁"
      id="mw4-dmz-fob"
      rows={rows}
      isTemplate={false}
      note={"未填 / 留空：3D Printer 具体配方数值、Bank/Stash 扩容费用、MIA Recovery 折扣、Gunsmith/Vendor 折扣与轮换库存——官方 Part 2 未给出可引用全表，本批不标 confirmed。"}
    />
  </div>
  <div slot="sources">
    <div class="table-scroll">
      <table>
        <caption>Sources and update dates</caption>
        <thead><tr><th scope="col">#</th><th scope="col">Source</th><th scope="col">Date</th><th scope="col">Notes</th></tr></thead>
        <tbody>
          <tr id="source-1"><td>1</td><td><a href="https://www.callofduty.com/blog/2026/10/call-of-duty-modern-warfare-4-dmz-how-to-play-forward-operating-base-guide">DMZ Deep Dive, Part 2: FOB Full Intel Guide</a></td><td>October 09, 2026；核验 2026-10-24</td><td>站点清单、解锁等级/条件、What it enables 主源</td></tr>
          <tr id="source-2"><td>2</td><td><a href="https://www.callofduty.com/blog/2026/10/call-of-duty-modern-warfare-4-ready-for-launch-progression-prestige">Ready for Launch: Progression and Prestige</a></td><td>October 19, 2026；核验 2026-10-24</td><td>DMZ 1–70 与 Station Unlocks（含 3D Printer@2、Gunsmith@10、Dog Tag Case@20）附录对照</td></tr>
        </tbody>
      </table>
    </div>
    <p>Sources: <a href="#source-1">[1]</a><a href="#source-2">[2]</a></p>
  </div>
</GuideLayout>
